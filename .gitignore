# --- Secrets / local config ---
.env
.env.*
*.key
*.pem

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# --- Editor / OS junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
